# Gradle
.gradle/
build/
/build/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin
*.class

# IntelliJ IDEA
.idea/
*.iml
*.iws

# VS Code
.vscode/*
!.vscode/tasks.json

# Environment / Secrets
.env
github-variables.env

# Data directories created by Docker or app
data/

# Zensical（ドキュメントサイト）
# site/ はビルド成果物。.venv/ はローカルプレビュー用の Python 仮想環境。
# .cache/ は Zensical が自前の .gitignore を置くため、ここでの指定は不要。
site/
.venv/

# Terraform
**/.terraform/
terraform.tfvars
terraform.tfstate
terraform.tfstate.backup

# AI agent local settings (共有しない個人設定)
# .claude/skills は .agents/skills へのシンボリックリンクなので追跡する
.claude/*
!.claude/skills
!.claude/settings.json
.codex/

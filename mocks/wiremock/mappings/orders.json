{
  "request": {
    "method": "GET",
    "urlPath": "/v1/orders",
    "queryParameters": {
      "orderId": {
        "matches": ".*"
      }
    },
    "headers": {
      "API-KEY": {
        "matches": ".*"
      },
      "API-TIMESTAMP": {
        "matches": ".*"
      },
      "API-SIGN": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "orders_response.json"
  }
}
